</style>

<script>
    // Global Data
    const hotelOwnerData = localStorage.getItem("hotelOwner");
    const hotelOwner = hotelOwnerData ? JSON.parse(hotelOwnerData) : null;
    const hotelId = hotelOwner?.id;

    if (!hotelId) {
        console.error("FATAL: No hotelId found in localStorage");
        // Optional: Redirect to login or show error
        // window.location.href = '/auth/hotel-owner-login';
    }

    let customers = [];
    let feedbacks = [];
    let menuItems = [];
    let selectedItems = {}; // { itemId: { qty: number, price: number, name: string } }

    // Loyalty Program Logic
    let loyaltyRanges = JSON.parse(
        localStorage.getItem("pointznest_ranges"),
    ) || [
        { min: 1, max: 100, points: 5, bonus: 0 },
        { min: 101, max: 500, points: 20, bonus: 0 },
        { min: 501, max: 1000, points: 50, bonus: 0 },
        { min: 1001, max: null, points: 100, bonus: 0 },
    ];
    // Navigation Elements
    const navItems = document.querySelectorAll(".nav-item");
    const pageContents = document.querySelectorAll(".page-content");
    const pageTitle = document.getElementById("page-title");
    const actionCards = document.querySelectorAll(".action-card");

    // Navigation Logic
    function switchPage(pageId: string) {
        navItems.forEach((item) => {
            if (item.getAttribute("data-page") === pageId) {
                item.classList.add("active");
            } else {
                item.classList.remove("active");
            }
        });

        pageContents.forEach((page) => {
            page.classList.remove("active");
            if (page.id === `${pageId}-page`) {
                page.classList.add("active");

                const titleMap = {
                    dashboard: "Hotel Owner Dashboard",
                    "add-customer": "Bill Generation",
                    "customer-management": "Customer Management",
                    "loyalty-program": "Loyalty Program",
                    "feedback-ratings": "Feedback & Ratings",
                    "revenue-reports": "Revenue Reports",
                };
                if (pageTitle) pageTitle.textContent = titleMap[pageId];

                if (pageId === "customer-management") {
                    loadCustomers();
                }

                if (pageId === "revenue-reports") {
                    loadRevenueReports();
                }
            }
        });
    }

    navItems.forEach((item) => {
        item.addEventListener("click", () => {
            const pageId = item.getAttribute("data-page");
            if (pageId) switchPage(pageId);
        });
    });

    actionCards.forEach((card) => {
        card.addEventListener("click", () => {
            const pageId = card.getAttribute("data-page");
            if (pageId) switchPage(pageId);
        });
    });

    // Updated Bill Calculation Logic
    const foodTotalDisplay = document.getElementById("food-total-display");
    const foodInputHidden = document.getElementById(
        "food-beverages",
    ) as HTMLInputElement; // Hidden input for compatibility

    // Other inputs
    const servicesInput = document.getElementById(
        "other-services",
    ) as HTMLInputElement;
    const taxInput = document.getElementById("tax") as HTMLInputElement;
    const totalAmountSpan = document.getElementById("total-amount");
    const pointsEarnedDiv = document.getElementById("points-earned");
    let calculatedPoints = 0;

    function calculateTotal() {
        let foodTotal = 0;

        // Calculate food total from selected items
        Object.values(selectedItems).forEach((item: any) => {
            foodTotal += item.qty * item.price;
        });

        // Update food display
        if (foodTotalDisplay)
            foodTotalDisplay.textContent = `₹${foodTotal.toFixed(2)}`;
        if (foodInputHidden) foodInputHidden.value = foodTotal.toString();

        const services = parseFloat(servicesInput?.value) || 0;
        const tax = parseFloat(taxInput?.value) || 0;

        const total = foodTotal + services + tax;
        if (totalAmountSpan)
            totalAmountSpan.textContent = `₹${total.toFixed(2)}`;

        // Calculate Points based on Ranges
        let fixedPoints = 0;
        let bonus = 0;

        for (const range of loyaltyRanges) {
            if (
                total >= range.min &&
                (range.max === null || total <= range.max)
            ) {
                fixedPoints = range.points;
                bonus = range.bonus;
                break;
            }
        }

        calculatedPoints = fixedPoints + bonus;
        if (pointsEarnedDiv)
            pointsEarnedDiv.textContent = `${calculatedPoints} points`;
    }

    // Load Menu Items
    async function loadMenuItems() {
        if (!hotelId) return;
        const container = document.getElementById("menu-items-container");
        if (!container) return;

        try {
            const res = await fetch(
                `http://localhost:7000/api/menu/${hotelId}`,
            );
            if (res.ok) {
                menuItems = await res.json();
                renderMenuSelection();
            } else {
                container.innerHTML =
                    '<p class="text-danger">Failed to load menu.</p>';
            }
        } catch (error) {
            console.error("Error loading menu:", error);
            container.innerHTML =
                '<p class="text-danger">Error loading menu.</p>';
        }
    }

    function renderMenuSelection() {
        const container = document.getElementById("menu-items-container");
        if (!container) return;
        container.innerHTML = "";

        if (menuItems.length === 0) {
            container.innerHTML =
                '<p>No menu items found. Please add items in "View Menu".</p>';
            return;
        }

        menuItems.forEach((item: any) => {
            const itemDiv = document.createElement("div");
            itemDiv.className = "menu-item-select";
            itemDiv.innerHTML = `
                <div class="item-info">
                    <span class="item-name">${item.name}</span>
                    <span class="item-price">₹${item.price}</span>
                </div>
                <div class="item-controls">
                    <button type="button" class="btn-qty minus" data-id="${item._id}">-</button>
                    <span class="qty-display" id="qty-${item._id}">0</span>
                    <button type="button" class="btn-qty plus" data-id="${item._id}">+</button>
                </div>
            `;
            container.appendChild(itemDiv);

            // Add event listeners for this item
            const minusBtn = itemDiv.querySelector(".minus");
            const plusBtn = itemDiv.querySelector(".plus");

            minusBtn?.addEventListener("click", () => updateItemQty(item, -1));
            plusBtn?.addEventListener("click", () => updateItemQty(item, 1));
        });
    }

    function updateItemQty(item, change) {
        if (!selectedItems[item._id]) {
            selectedItems[item._id] = {
                qty: 0,
                price: item.price,
                name: item.name,
            };
        }

        selectedItems[item._id].qty += change;
        if (selectedItems[item._id].qty < 0) selectedItems[item._id].qty = 0;

        // Update UI
        const qtyDisplay = document.getElementById(`qty-${item._id}`);
        if (qtyDisplay) qtyDisplay.textContent = selectedItems[item._id].qty;

        calculateTotal();
    }

    // Initialize
    loadMenuItems();

    [servicesInput, taxInput].forEach((input) => {
        if (input) input.addEventListener("input", calculateTotal);
    });

    // Customer Form Submission
    const customerForm = document.getElementById("customer-form");
    if (customerForm) {
        customerForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const name = (
                document.getElementById("customer-name") as HTMLInputElement
            ).value;
            const phone = (
                document.getElementById("customer-phone") as HTMLInputElement
            ).value;
            const email = undefined;

            // Get bill details
            const foodVal =
                parseFloat(
                    (
                        document.getElementById(
                            "food-beverages",
                        ) as HTMLInputElement
                    )?.value,
                ) || 0;
            const servicesVal =
                parseFloat(
                    (
                        document.getElementById(
                            "other-services",
                        ) as HTMLInputElement
                    )?.value,
                ) || 0;
            const taxVal =
                parseFloat(
                    (document.getElementById("tax") as HTMLInputElement)?.value,
                ) || 0;

            const totalText =
                document.getElementById("total-amount")?.textContent || "0";
            const totalVal = parseFloat(totalText.replace("₹", ""));

            try {
                // 1. Create Customer
                const response = await fetch(
                    "http://localhost:7000/api/customer/add",
                    {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            name,
                            email,
                            phone,
                        }),
                    },
                );

                const result = await response.json();

                if (response.ok) {
                    // 2. If Customer created, generate Bill
                    const customerId = result.customer?.customer_id;

                    if (!customerId) {
                        throw new Error(
                            "Backend failed to provide a valid Customer ID",
                        );
                    }

                    // Format ordered items for backend
                    const ordered_items = Object.keys(selectedItems)
                        .filter((key) => selectedItems[key].qty > 0)
                        .map((key) => ({
                            menu_item_id: key,
                            menu_item_name: selectedItems[key].name,
                            quantity: selectedItems[key].qty,
                            price: selectedItems[key].price,
                        }));

                    const billResponse = await fetch(
                        "http://localhost:7000/api/bill/create",
                        {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                customer_id: customerId,
                                hotel_id: hotelId,
                                bill_details: {
                                    food: foodVal,
                                    services: servicesVal,
                                    tax: taxVal,
                                    total: totalVal,
                                },
                                points_earned: calculatedPoints,
                                ordered_items: ordered_items,
                            }),
                        },
                    );

                    const billResult = await billResponse.json();

                    if (billResponse.ok) {
                        alert(
                            `Bill generated successfully for ${name}\nTotal Amount: ₹${totalVal.toFixed(2)}`,
                        );
                        customerForm.reset();
                        calculateTotal();
                        loadCustomers();
                    } else {
                        alert(
                            "Customer added, but failed to generate bill: " +
                                (billResult.error || "Unknown error"),
                        );
                    }
                } else {
                    alert(
                        "Error adding customer: " +
                            (result.message || result.error || "Unknown error"),
                    );
                }
            } catch (err) {
                console.error(err);
                alert("Failed to connect to server.");
            }
        });
    }

    // Load Customers (API)
    async function loadCustomers() {
        const tableBody = document.getElementById("customers-table-body");
        const emptyState = document.getElementById("no-customers-message");
        const countDisplay = document.getElementById("total-customers-count");

        try {
            const response = await fetch(
                "http://localhost:7000/api/customer/all",
            );
            customers = await response.json();

            if (tableBody) {
                if (Array.isArray(customers) && customers.length > 0) {
                    // Deduplicate customers by phone number for the view
                    const uniqueCustomersMap = new Map();
                    customers.forEach((c) => {
                        const phone = c.phone;
                        if (!uniqueCustomersMap.has(phone)) {
                            uniqueCustomersMap.set(phone, { ...c });
                        } else {
                            // Merge points if duplicates exist in DB
                            const existing = uniqueCustomersMap.get(phone);
                            existing.points =
                                (existing.points || 0) + (c.points || 0);
                        }
                    });
                    const uniqueCustomers = Array.from(
                        uniqueCustomersMap.values(),
                    );

                    if (emptyState) emptyState.style.display = "none";
                    tableBody.innerHTML = "";
                    uniqueCustomers.forEach((customer) => {
                        const row = document.createElement("tr");
                        const displayId =
                            customer.customer_id ||
                            (customer._id
                                ? customer._id.substring(0, 8).toUpperCase()
                                : "N/A");
                        row.innerHTML = `
                            <td>#${displayId}</td>
                            <td>${customer.username}</td>
                            <td>${customer.email || "-"}</td>
                            <td>${customer.phone}</td>
                            <td style="color: #000; font-weight: 500;">${customer.points || 0} pts</td>
                        `;
                        tableBody.appendChild(row);
                    });
                    if (countDisplay)
                        countDisplay.textContent =
                            uniqueCustomers.length.toString();
                } else {
                    tableBody.innerHTML = "";
                    if (emptyState) emptyState.style.display = "block";
                    if (countDisplay) countDisplay.textContent = "0";
                }
            }
            populateCustomerDropdown();
        } catch (err) {
            console.error(err);
        }
    }

    // Load Feedbacks (API)
    async function loadFeedbacks() {
        try {
            console.log("Fetching feedbacks...");
            const res = await fetch("http://localhost:7000/api/feedback/all");
            console.log("Feedback response status:", res.status);

            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);

            feedbacks = await res.json();
            console.log("Loaded feedbacks client-side:", feedbacks);

            renderFeedbacks();
            updateFeedbackStats();
        } catch (err) {
            console.error("Error fetching feedbacks:", err);
        }
    }

    // Render Feedbacks
    function renderFeedbacks() {
        const container = document.getElementById("feedback-container");
        const noFeedbackMsg = document.getElementById("no-feedback-message");
        const filterElement = document.getElementById(
            "feedback-filter",
        ) as HTMLSelectElement;
        const filterValue = filterElement ? filterElement.value : "all";

        if (!container) return;

        let filteredFeedbacks = feedbacks;
        if (filterValue !== "all") {
            const rating = parseInt(filterValue);
            filteredFeedbacks = feedbacks.filter(
                (f) => Math.floor(f.rating) === rating,
            );
        }

        if (filteredFeedbacks.length === 0) {
            container.innerHTML = "";
            if (noFeedbackMsg) noFeedbackMsg.style.display = "block";
            return;
        }

        if (noFeedbackMsg) noFeedbackMsg.style.display = "none";
        container.innerHTML = "";

        const avatarClasses = [
            "avatar-blue",
            "avatar-green",
            "avatar-purple",
            "avatar-orange",
            "avatar-teal",
            "avatar-indigo",
        ];

        filteredFeedbacks.forEach((feedback, index) => {
            const feedbackItem = document.createElement("div");
            feedbackItem.className = "feedback-item";

            const avatarClass = avatarClasses[index % avatarClasses.length];

            let starsHtml = "";
            const score = parseFloat(feedback.rating) || 0;
            const fullStars = Math.floor(score);
            const hasHalfStar = score % 1 >= 0.5;
            for (let i = 0; i < fullStars; i++)
                starsHtml += '<i class="fas fa-star"></i>';
            if (hasHalfStar)
                starsHtml += '<i class="fas fa-star-half-alt"></i>';
            const emptyStars = 5 - Math.ceil(score);
            for (let i = 0; i < emptyStars; i++)
                starsHtml += '<i class="far fa-star"></i>';

            const dateObj = new Date(feedback.feedback_date || feedback.date);
            const dateStr = dateObj.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
            });

            // Rating-based color class
            let ratingColor = "#e67e22"; // orange
            if (score >= 4.5)
                ratingColor = "#27ae60"; // green
            else if (score >= 3.5)
                ratingColor = "#f39c12"; // amber
            else if (score < 3) ratingColor = "#e74c3c"; // red

            feedbackItem.innerHTML = `
                <div class="card-header">
                    <div class="customer-profile">
                        <div class="feedback-avatar ${avatarClass}">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="customer-info">
                            <span class="feedback-name">${feedback.customerName || "Anonymous"}</span>
                            <span class="feedback-date">${dateStr}</span>
                        </div>
                    </div>
                    <div class="feedback-rating-badge" style="background: ${ratingColor}15; color: ${ratingColor};">
                        ${starsHtml}
                        <strong style="margin-left: 5px;">${score}</strong>
                    </div>
                </div>
                
                <div class="card-body">
                    <p class="feedback-comment">"${feedback.comment}"</p>
                </div>
            `;
            container.appendChild(feedbackItem);
        });
    }

    function populateCustomerDropdown() {
        const select = document.getElementById("feedback-customer-select");
        if (select) {
            select.innerHTML = '<option value="">Select Customer</option>';
            customers.forEach((c) => {
                const option = document.createElement("option");
                option.value = c.id;
                option.textContent = `${c.username} (${c.email || "-"})`;
                select.appendChild(option);
            });
        }
    }

    // Add Feedback Modal
    const addFeedbackBtn = document.getElementById("add-feedback-btn");
    if (addFeedbackBtn) {
        addFeedbackBtn.addEventListener("click", () => {
            let modal = document.getElementById("add-feedback-modal");
            if (!modal) {
                modal = document.createElement("div");
                modal.id = "add-feedback-modal";
                modal.style.cssText =
                    "position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;justify-content:center;align-items:center;z-index:1000;";
                modal.innerHTML = `
                    <div style="background:white;padding:2rem;border-radius:8px;width:90%;max-width:500px;">
                        <h3 style="margin-bottom:1rem; color: #333;">Add Feedback</h3>
                        <form id="add-feedback-form">
                            <div class="form-group">
                                <label style="display:block;margin-bottom:5px;">Customer</label>
                                <select id="feedback-customer-select" class="form-control" required style="width:100%;padding:10px;margin-bottom:15px;"></select>
                            </div>
                            <div class="form-group">
                                <label style="display:block;margin-bottom:5px;">Rating</label>
                                <select id="feedback-rating-select" class="form-control" required style="width:100%;padding:10px;margin-bottom:15px;">
                                    <option value="5">5 - Excellent</option>
                                    <option value="4">4 - Very Good</option>
                                    <option value="3">3 - Good</option>
                                    <option value="2">2 - Fair</option>
                                    <option value="1">1 - Poor</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label style="display:block;margin-bottom:5px;">Comment</label>
                                <textarea id="feedback-comment-text" class="form-control" rows="3" required style="width:100%;padding:10px;margin-bottom:15px;"></textarea>
                            </div>
                            <div style="display:flex;justify-content:flex-end;gap:10px;">
                                <button type="button" class="btn" style="background:#ccc;" onclick="document.getElementById('add-feedback-modal').style.display='none'">Cancel</button>
                                <button type="submit" class="btn btn-primary" style="background:#e67e22;color:white;border:none;padding:10px 20px;border-radius:4px;">Submit</button>
                            </div>
                        </form>
                    </div>
                `;
                document.body.appendChild(modal);

                const form = document.getElementById("add-feedback-form");
                if (form) {
                    form.addEventListener("submit", async (e) => {
                        e.preventDefault();
                        const customerId = (
                            document.getElementById(
                                "feedback-customer-select",
                            ) as HTMLSelectElement
                        ).value;
                        const rating = (
                            document.getElementById(
                                "feedback-rating-select",
                            ) as HTMLSelectElement
                        ).value;
                        const comment = (
                            document.getElementById(
                                "feedback-comment-text",
                            ) as HTMLTextAreaElement
                        ).value;

                        try {
                            const res = await fetch(
                                "http://localhost:7000/api/feedback/add",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type": "application/json",
                                    },
                                    body: JSON.stringify({
                                        customer_id: customerId,
                                        rating,
                                        comment,
                                    }),
                                },
                            );
                            if (res.ok) {
                                alert("Feedback added!");
                                modal.style.display = "none";
                                loadFeedbacks();
                                form.reset();
                            } else {
                                alert("Failed to add feedback");
                            }
                        } catch (err) {
                            console.error(err);
                        }
                    });
                }
            }
            populateCustomerDropdown();
            modal.style.display = "flex";
        });
    }

    const feedbackFilter = document.getElementById("feedback-filter");
    if (feedbackFilter) {
        feedbackFilter.addEventListener("change", renderFeedbacks);
    }

    function renderLoyaltyRanges() {
        const tableBody = document.getElementById("range-table-body");
        if (!tableBody) return;

        tableBody.innerHTML = "";

        loyaltyRanges.forEach((range, index) => {
            const row = document.createElement("tr");
            row.innerHTML = `
            <td>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <input type="number" class="form-control range-input min-input" value="${range.min}" min="0" placeholder="Min" data-index="${index}" style="width: 80px; padding: 5px;"> 
                    <span>-</span> 
                    <input type="number" class="form-control range-input max-input" value="${range.max !== null ? range.max : ""}" min="1" placeholder="Max" data-index="${index}" style="width: 80px; padding: 5px;">
                </div>
            </td>
            <td>
                <input type="number" class="form-control points-input" data-index="${index}" value="${range.points}" placeholder="Points">
            </td>
            <td>
                <input type="number" class="form-control range-input bonus-input" value="${range.bonus}" min="0" placeholder="Bonus" data-index="${index}" style="width: 80px; padding: 5px;">
            </td>
        `;
            tableBody.appendChild(row);
        });
    }

    window.removeRange = function (index) {
        if (loyaltyRanges.length > 1) {
            loyaltyRanges.splice(index, 1);
            renderLoyaltyRanges();
        } else {
            alert("You need at least one range in the loyalty program.");
        }
    };

    const addRangeBtn = document.querySelector(
        ".section-header button.btn-success",
    );
    if (addRangeBtn) {
        addRangeBtn.addEventListener("click", () => {
            loyaltyRanges.push({
                min: (loyaltyRanges[loyaltyRanges.length - 1].max || 0) + 1,
                max: null,
                pointsPerDollar: 10,
                bonus: 0,
            });
            renderLoyaltyRanges();
        });
    }

    const applyRangesBtn = document.getElementById("apply-ranges-btn");
    if (applyRangesBtn) {
        applyRangesBtn.addEventListener("click", () => {
            const newRanges = [];
            let isValid = true;

            for (let i = 0; i < loyaltyRanges.length; i++) {
                const minInput = document.querySelector(
                    `.min-input[data-index="${i}"]`,
                );
                const maxInput = document.querySelector(
                    `.max-input[data-index="${i}"]`,
                );
                const pointsInput = document.querySelector(
                    `.points-input[data-index="${i}"]`,
                );
                const bonusInput = document.querySelector(
                    `.bonus-input[data-index="${i}"]`,
                );

                if (!minInput || !maxInput || !pointsInput || !bonusInput)
                    continue;

                const min = parseFloat(minInput.value) || 0;
                const max = maxInput.value ? parseFloat(maxInput.value) : null;
                const points = parseFloat(pointsInput.value) || 0;
                const bonus = parseFloat(bonusInput.value) || 0;

                if (max !== null && max <= min) {
                    alert(
                        `Range ${i + 1}: Maximum must be greater than minimum.`,
                    );
                    isValid = false;
                    break;
                }

                newRanges.push({ min, max, points, bonus });
            }

            if (isValid) {
                loyaltyRanges = newRanges;
                localStorage.setItem(
                    "pointznest_ranges",
                    JSON.stringify(loyaltyRanges),
                );
                alert("Loyalty program ranges applied successfully!");
                calculateTotal(); // Update points on currently open bill
            }
        });
    }

    // Save Program Configuration
    const saveLoyaltyConfigBtn = document.getElementById(
        "save-loyalty-config-btn",
    );
    if (saveLoyaltyConfigBtn) {
        saveLoyaltyConfigBtn.addEventListener("click", () => {
            const config = {
                programName: (
                    document.getElementById("program-name") as HTMLInputElement
                ).value,
                status: (
                    document.getElementById(
                        "program-status",
                    ) as HTMLSelectElement
                ).value,
                welcomeBonus:
                    parseFloat(
                        (
                            document.getElementById(
                                "welcome-bonus",
                            ) as HTMLInputElement
                        ).value,
                    ) || 0,
                expiry:
                    parseFloat(
                        (
                            document.getElementById(
                                "points-expiry",
                            ) as HTMLInputElement
                        ).value,
                    ) || 0,
            };
            localStorage.setItem(
                "pointznest_loyalty_config",
                JSON.stringify(config),
            );
            alert("Program configuration saved!");
        });
    }

    // Load initial config
    const savedConfig = localStorage.getItem("pointznest_loyalty_config");
    if (savedConfig) {
        const config = JSON.parse(savedConfig);
        const nameInput = document.getElementById(
            "program-name",
        ) as HTMLInputElement;
        const statusSelect = document.getElementById(
            "program-status",
        ) as HTMLSelectElement;
        const bonusInput = document.getElementById(
            "welcome-bonus",
        ) as HTMLInputElement;
        const expiryInput = document.getElementById(
            "points-expiry",
        ) as HTMLInputElement;

        if (nameInput) nameInput.value = config.programName;
        if (statusSelect) statusSelect.value = config.status;
        if (bonusInput) bonusInput.value = config.welcomeBonus;
        if (expiryInput) expiryInput.value = config.expiry;
    }

    const resetRangesBtn = document.getElementById("reset-ranges-btn");
    if (resetRangesBtn) {
        resetRangesBtn.addEventListener("click", () => {
            if (confirm("Reset ranges to default?")) {
                loyaltyRanges = [
                    { min: 1, max: 100, points: 5, bonus: 0 },
                    { min: 101, max: 500, points: 20, bonus: 0 },
                    { min: 501, max: 1000, points: 50, bonus: 0 },
                    { min: 1001, max: null, points: 100, bonus: 0 },
                ];
                localStorage.setItem(
                    "pointznest_ranges",
                    JSON.stringify(loyaltyRanges),
                );
                renderLoyaltyRanges();
                calculateTotal(); // Update currently opened bill if any
            }
        });
    }

    // Initialization
    loadCustomers();
    loadFeedbacks();
    renderLoyaltyRanges();
    updateFeedbackStats();
    loadRevenueReports();

    async function loadRevenueReports() {
        const ctx = document.getElementById(
            "spendAnalyzerChart",
        ) as HTMLCanvasElement;
        if (!ctx) return;

        try {
            // Process data for Chart (Dynamic Menu Data)
            let labels = ["No Items", "No Items", "No Items"];
            let values = [0, 0, 0];
            let topCustomers = ["Arjun", "Priya", "Rahul", "Deepak", "Sneha"];

            if (customers && customers.length > 0) {
                topCustomers = customers.map((c: any) => c.username || c.name);
            }

            if (menuItems && menuItems.length > 0) {
                // Use actual menu items
                labels = menuItems.slice(0, 5).map((item: any) => item.name);
                // Assign realistic static revenue values for the trial
                values = labels.map((_, i) => 15000 - i * 2000);
            }

            // Update Top Moving Items Table Dynamically
            const tableBody = document.getElementById("top-moving-items-body");
            if (tableBody) {
                tableBody.innerHTML = "";
                labels.forEach((name, i) => {
                    if (name === "No Items") return;
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td>${name}</td>
                        <td>₹${values[i].toLocaleString()}</td>
                        <td><span class="badge badge-info">${topCustomers[i % topCustomers.length]}</span></td>
                    `;
                    tableBody.appendChild(row);
                });
            }

            // Update Summary Cards with Static Trial Data
            const totalRevenue = values.reduce((a, b) => a + b, 0);
            const monthlyRevenueEl = document.getElementById("monthly-revenue");
            if (monthlyRevenueEl)
                monthlyRevenueEl.textContent = `₹${totalRevenue.toLocaleString()}`;

            const loyaltyImpactEl = document.getElementById("loyalty-impact");
            if (loyaltyImpactEl) loyaltyImpactEl.textContent = "65%";

            const revenueGrowthEl = document.getElementById("revenue-growth");
            if (revenueGrowthEl) revenueGrowthEl.textContent = "+12%";

            // Destroy existing chart if any
            if ((window as any).spendChart) {
                (window as any).spendChart.destroy();
            }

            // Custom Colors (Blue, Dark Blue, Green, Purple, Orange, Red, Yellow)
            const backgroundColors = [
                "rgba(54, 162, 235, 0.8)",
                "rgba(26, 35, 126, 0.8)",
                "rgba(75, 192, 192, 0.8)",
                "rgba(153, 102, 255, 0.8)",
                "rgba(255, 159, 64, 0.8)",
                "rgba(255, 99, 132, 0.8)",
                "rgba(255, 205, 86, 0.8)",
            ];

            const borderColors = [
                "rgba(54, 162, 235, 1)",
                "rgba(26, 35, 126, 1)",
                "rgba(75, 192, 192, 1)",
                "rgba(153, 102, 255, 1)",
                "rgba(255, 159, 64, 1)",
                "rgba(255, 99, 132, 1)",
                "rgba(255, 205, 86, 1)",
            ];

            // Render Chart
            // @ts-ignore
            (window as any).spendChart = new Chart(ctx, {
                type: "bar",
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: "Revenue",
                            data: values,
                            backgroundColor: backgroundColors,
                            borderColor: borderColors,
                            borderWidth: 1,
                            barPercentage: 0.6,
                            categoryPercentage: 0.8,
                        },
                    ],
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false,
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context: any) {
                                    return `Revenue: ₹${context.raw}`;
                                },
                            },
                        },
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                display: false,
                                drawBorder: true,
                            },
                            title: {
                                display: true,
                                text: "Revenue (₹)",
                                font: {
                                    weight: "bold",
                                    size: 14,
                                },
                                color: "#333",
                            },
                            ticks: {
                                font: {
                                    weight: "bold",
                                },
                            },
                        },
                        x: {
                            grid: {
                                display: false,
                                drawBorder: true,
                            },
                            title: {
                                display: true,
                                text: "Menu Items",
                                font: {
                                    weight: "bold",
                                    size: 14,
                                },
                                color: "#333",
                            },
                            ticks: {
                                font: {
                                    weight: "bold",
                                },
                            },
                        },
                    },
                },
            });
        } catch (err) {
            console.error("Error loading spend analyzer:", err);
        }
    }

    function updateFeedbackStats() {
        const avgRatingEl = document.getElementById("avg-rating-value");
        const avgStarsEl = document.getElementById("avg-rating-stars");
        const totalReviewsEl = document.getElementById("total-reviews-value");
        const positiveFeedbackEl = document.getElementById(
            "positive-feedback-value",
        );

        const totalReviews = feedbacks.length;
        let avgRating = 0;
        let positiveCount = 0;

        if (totalReviews > 0) {
            const sum = feedbacks.reduce(
                (acc, curr) => acc + (parseFloat(curr.rating) || 0),
                0,
            );
            avgRating = sum / totalReviews;

            feedbacks.forEach((f) => {
                if ((parseFloat(f.rating) || 0) >= 4) {
                    positiveCount++;
                }
            });
        }

        const positivePercentage =
            totalReviews > 0
                ? Math.round((positiveCount / totalReviews) * 100)
                : 0;

        // Update DOM
        if (totalReviewsEl)
            totalReviewsEl.textContent = totalReviews.toString();
        if (avgRatingEl) avgRatingEl.textContent = avgRating.toFixed(1);
        if (positiveFeedbackEl)
            positiveFeedbackEl.textContent = `${positivePercentage}%`;

        // Update Stars
        if (avgStarsEl) {
            let starsHtml = "";
            const fullStars = Math.floor(avgRating);
            const hasHalfStar = avgRating % 1 >= 0.5; // Simple half star logic

            for (let i = 0; i < fullStars; i++)
                starsHtml += '<i class="fas fa-star"></i>';
            if (hasHalfStar)
                starsHtml += '<i class="fas fa-star-half-alt"></i>';

            const emptyStars =
                5 - Math.ceil(hasHalfStar ? avgRating : avgRating);
            // Better empty star calc: 5 - full - (1 if half)
            const filledCount = fullStars + (hasHalfStar ? 1 : 0);
            for (let i = 0; i < 5 - filledCount; i++)
                starsHtml += '<i class="far fa-star"></i>';

            avgStarsEl.innerHTML = starsHtml;
        }
    }

    // Export Report
    const exportBtn = document.getElementById("export-report-btn");
    if (exportBtn) {
        exportBtn.addEventListener("click", () => {
            window.location.href = "http://localhost:7000/api/reports/export";
        });
    }

    // Handle Hash Navigation
    function handleHashNavigation() {
        const hash = window.location.hash.substring(1);
        if (hash) {
            const navItem = document.querySelector(
                `.nav-item[data-page="${hash}"]`,
            );
            if (navItem) {
                setTimeout(() => navItem.click(), 100);
            }
        }
    }

    // Check hash on load
    handleHashNavigation();
</script>
