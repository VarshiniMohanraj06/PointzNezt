---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="PointzNest - Customer Forgot Password">
    <div class="page-wrapper">
        <!-- Header -->
        <div class="header-content">
            <div class="logo">
                <h1><i class="fas fa-star"></i> PointzNest</h1>
            </div>
            <h2 class="page-title">Customer - Forgot Password</h2>
        </div>

        <!-- Form container -->
        <div class="container">
            <!-- Step 1: Contact Method Selection -->
            <div id="step1" class="form-step active">
                <p class="step-desc">Choose how you want to receive OTP</p>

                <div class="contact-toggle">
                    <div class="contact-option active" data-method="email">
                        <i class="fas fa-envelope"></i>
                        <div>Email</div>
                    </div>
                    <div class="contact-option" data-method="phone">
                        <i class="fas fa-phone"></i>
                        <div>Phone</div>
                    </div>
                </div>

                <div class="form-group" id="emailGroup">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        placeholder="Enter your registered email address"
                        required
                    />
                </div>

                <div class="form-group" id="phoneGroup" style="display: none;">
                    <label for="phone">Phone Number</label>
                    <input
                        type="tel"
                        id="phone"
                        placeholder="Enter your registered phone number"
                        required
                    />
                </div>

                <button class="btn btn-primary" id="send-otp-btn">
                    <i class="fas fa-paper-plane"></i> Send OTP
                </button>

                <div class="back-to-login">
                    <a href="/auth/customer-login"
                        ><i class="fas fa-arrow-left"></i> Back to Customer Login</a
                    >
                </div>
            </div>

            <!-- Step 2: OTP Verification -->
            <div id="step2" class="form-step">
                <p class="step-desc">
                    Enter the 6-digit OTP sent to your <span id="contactMethod"
                    ></span>
                </p>

                <div class="otp-container">
                    <input type="text" class="otp-input" maxlength="1" />
                    <input type="text" class="otp-input" maxlength="1" />
                    <input type="text" class="otp-input" maxlength="1" />
                    <input type="text" class="otp-input" maxlength="1" />
                    <input type="text" class="otp-input" maxlength="1" />
                    <input type="text" class="otp-input" maxlength="1" />
                </div>

                <div class="resend-otp">
                    Didn't receive OTP? <a href="#" id="resend-otp-link"
                        >Resend OTP</a
                    >
                </div>

                <button class="btn btn-primary" id="verify-otp-btn">
                    <i class="fas fa-check-circle"></i> Verify OTP
                </button>

                <div class="back-to-login">
                    <a href="#" id="back-to-step1"
                        ><i class="fas fa-arrow-left"></i> Back</a
                    >
                </div>
            </div>

            <!-- Step 3: Password Reset -->
            <div id="step3" class="form-step">
                <p class="step-desc">Create your new password</p>

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <input
                        type="password"
                        id="newPassword"
                        placeholder="Enter new password"
                        required
                    />
                    <div class="password-strength">
                        <div class="strength-meter" id="passwordStrength"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input
                        type="password"
                        id="confirmPassword"
                        placeholder="Confirm new password"
                        required
                    />
                    <div
                        id="passwordMatch"
                        style="color: #e74c3c; font-size: 0.9rem; margin-top: 0.3rem;"
                    >
                    </div>
                </div>

                <button class="btn btn-white" id="reset-password-btn">
                    <i class="fas fa-key"></i> Reset Password
                </button>

                <div class="back-to-login">
                    <a href="#" id="back-to-step2"
                        ><i class="fas fa-arrow-left"></i> Back to OTP</a
                    >
                </div>
            </div>

            <!-- Step 4: Success Message -->
            <div id="step4" class="form-step">
                <div class="success-message">
                    <i class="fas fa-check-circle"></i>
                    <p>Your password has been reset successfully.</p>
                    <p>Redirecting to Customer Login...</p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    /* Reusing styles from hotel owner forgot password for consistency */
    .page-wrapper {
        background:
            linear-gradient(rgba(44, 62, 80, 0.9), rgba(44, 62, 80, 0.9)),
            url("https://images.unsplash.com/photo-1556742049-0cfed4f7a07d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"); /* Different image for customer */
        background-size: cover;
        background-position: center;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
        color: white;
    }

    .header-content {
        text-align: center;
        margin-bottom: 2rem;
        width: 100%;
        max-width: 500px;
    }
    .logo {
        margin-bottom: 1rem;
    }
    .logo h1 {
        color: #ffffff;
        font-size: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    }
    .logo i {
        color: #e67e22; /* Maintaining secondary color */
        font-size: 2.8rem;
        animation: blink 2s infinite;
    }
    @keyframes blink {
        0%,
        100% {
            opacity: 1;
            text-shadow: 0 0 10px #e67e22;
        }
        50% {
            opacity: 0.7;
            text-shadow: 0 0 20px #e67e22;
        }
    }
    .page-title {
        color: #ffffff;
        font-size: 2rem;
        margin-bottom: 1rem;
        font-weight: 600;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .container {
        width: 100%;
        max-width: 500px;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(12px);
        border-radius: 15px;
        padding: 2.5rem;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.15);
        margin: 0 auto;
    }

    .form-step {
        display: none;
    }
    .form-step.active {
        display: block;
        animation: fadeIn 0.5s ease-in;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .step-desc {
        text-align: center;
        color: #ffffff;
        margin-bottom: 1.5rem;
        font-weight: 500;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .form-group {
        margin-bottom: 1.5rem;
    }
    label {
        display: block;
        margin-bottom: 0.5rem;
        color: #ffffff;
        font-weight: 500;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    input,
    select {
        width: 100%;
        padding: 1rem;
        border-radius: 8px;
        font-size: 1rem;
        transition: border-color 0.3s;
        background: #ffffff;
        color: #000000;
        border: 2px solid #ddd;
    }
    input:focus {
        border-color: #e67e22;
        outline: none;
        box-shadow: 0 0 0 3px rgba(230, 126, 34, 0.2);
    }

    .btn {
        width: 100%;
        padding: 1rem;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        margin-top: 1rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }
    .btn-primary {
        background: #e67e22;
        color: white;
    }
    .btn-primary:hover {
        background: #d35400;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(230, 126, 34, 0.3);
    }
    .btn-white {
        background: #e67e22;
        color: white;
        border: 2px solid #e67e22;
    }
    .btn-white:hover {
        background: #d35400;
        border-color: #d35400;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(230, 126, 34, 0.3);
    }

    .contact-toggle {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .contact-option {
        flex: 1;
        padding: 1rem;
        text-align: center;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
        color: #ffffff;
    }
    .contact-option.active {
        border-color: #e67e22;
        background: rgba(230, 126, 34, 0.1);
    }
    .contact-option i {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        color: #e67e22;
    }

    .otp-container {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin: 1.5rem 0;
    }
    .otp-input {
        width: 45px;
        height: 55px;
        text-align: center;
        font-size: 1.5rem;
        font-weight: bold;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        color: #ffffff;
        padding: 0;
    }
    .otp-input:focus {
        border-color: #e67e22;
        outline: none;
        background: rgba(255, 255, 255, 0.2);
    }

    .resend-otp {
        text-align: center;
        margin: 1.5rem 0;
        color: #ffffff;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
    .resend-otp a {
        color: #e67e22;
        text-decoration: none;
        font-weight: 500;
    }
    .back-to-login {
        text-align: center;
        margin-top: 2rem;
    }
    .back-to-login a {
        color: #e67e22;
        text-decoration: none;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .password-strength {
        margin-top: 0.5rem;
        height: 6px;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 3px;
        overflow: hidden;
    }
    .strength-meter {
        height: 100%;
        width: 0%;
        transition:
            width 0.3s,
            background 0.3s;
    }

    .success-message {
        text-align: center;
        color: #27ae60;
        margin: 2rem 0;
    }
    .success-message i {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        display: block;
    }

    @media (max-width: 480px) {
        .otp-input {
            width: 35px;
            height: 45px;
            font-size: 1.2rem;
        }
        .otp-container {
            gap: 8px;
        }
    }
</style>

<script>
    let contactMethod = "email";
    let currentOtp = "";

    // Contact Method Selection
    document.querySelectorAll(".contact-option").forEach((option) => {
        option.addEventListener("click", () => {
            document
                .querySelectorAll(".contact-option")
                .forEach((opt) => opt.classList.remove("active"));
            option.classList.add("active");
            contactMethod = option.getAttribute("data-method") || "email";

            const emailGroup = document.getElementById("emailGroup");
            const phoneGroup = document.getElementById("phoneGroup");

            if (emailGroup && phoneGroup) {
                emailGroup.style.display =
                    contactMethod === "email" ? "block" : "none";
                phoneGroup.style.display =
                    contactMethod === "phone" ? "block" : "none";
            }
        });
    });

    // Send OTP
    const sendOtpBtn = document.getElementById("send-otp-btn");
    if (sendOtpBtn) {
        sendOtpBtn.addEventListener("click", async () => {
            // Basic validation
            const email = (document.getElementById("email") as HTMLInputElement)
                .value;
            const phone = (document.getElementById("phone") as HTMLInputElement)
                .value;

            if (contactMethod === "email" && !email) {
                alert("Enter email");
                return;
            }
            if (contactMethod === "phone" && !phone) {
                alert("Enter phone");
                return;
            }

            // Call Backend API
            try {
                const response = await fetch(
                    "http://localhost:7000/api/auth/forgot-password",
                    {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            method: contactMethod,
                            email:
                                contactMethod === "email" ? email : undefined,
                            phone:
                                contactMethod === "phone" ? phone : undefined,
                        }),
                    },
                );

                const data = await response.json();

                if (!response.ok) {
                    alert(
                        data.message +
                            (data.error ? `\nError: ${data.error}` : ""),
                    );
                    return;
                }

                // If success:
                // Transition
                const step1 = document.getElementById("step1");
                const step2 = document.getElementById("step2");
                const contactLabel = document.getElementById("contactMethod");

                if (step1 && step2 && contactLabel) {
                    step1.classList.remove("active");
                    step2.classList.add("active");
                    contactLabel.textContent = contactMethod;

                    // USER REQUEST: OTP need to be autofilled
                    // If backend sends a devOtp (dev mode), use that.
                    // If not, use '123456' mostly for demo purposes if backend didn't fail but no devOtp
                    const otpToFill = data.devOtp || "123456";

                    alert(
                        data.message +
                            (data.devOtp ? ` (OTP: ${data.devOtp})` : "") +
                            (data.warning
                                ? `\n\n[WARNING]: ${data.warning}`
                                : ""),
                    );

                    // Auto-fill effect
                    setTimeout(() => {
                        document
                            .querySelectorAll(".otp-input")
                            .forEach((inp, idx) => {
                                (inp as HTMLInputElement).value =
                                    otpToFill[idx] || "";
                            });
                    }, 1000);
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred. Please try again.");
            }
        });
    }

    // Verify OTP
    const verifyOtpBtn = document.getElementById("verify-otp-btn");
    if (verifyOtpBtn) {
        verifyOtpBtn.addEventListener("click", async () => {
            // Collect OTP
            const otpInputs = document.querySelectorAll(".otp-input");
            let otp = "";
            otpInputs.forEach(
                (inp) => (otp += (inp as HTMLInputElement).value),
            );

            if (otp.length !== 6) {
                alert("Please enter a 6-digit OTP");
                return;
            }

            const email = (document.getElementById("email") as HTMLInputElement)
                .value;
            const phone = (document.getElementById("phone") as HTMLInputElement)
                .value;

            try {
                const response = await fetch(
                    "http://localhost:7000/api/auth/verify-otp",
                    {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            email:
                                contactMethod === "email" ? email : undefined,
                            phone:
                                contactMethod === "phone" ? phone : undefined,
                            otp,
                        }),
                    },
                );

                const data = await response.json();
                if (!response.ok) {
                    alert(data.message || "Invalid OTP");
                    return;
                }

                // If success, go to Step 3
                const step2 = document.getElementById("step2");
                const step3 = document.getElementById("step3");

                if (step2 && step3) {
                    step2.classList.remove("active");
                    step3.classList.add("active");
                    currentOtp = otp; // Store for reset call
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred");
            }
        });
    }

    // Reset Password
    const resetBtn = document.getElementById("reset-password-btn");
    if (resetBtn) {
        resetBtn.addEventListener("click", async () => {
            const newPassword = (
                document.getElementById("newPassword") as HTMLInputElement
            ).value;
            const confirmPassword = (
                document.getElementById("confirmPassword") as HTMLInputElement
            ).value;

            if (newPassword !== confirmPassword) {
                alert("Passwords do not match");
                return;
            }

            const email = (document.getElementById("email") as HTMLInputElement)
                .value;
            const phone = (document.getElementById("phone") as HTMLInputElement)
                .value;

            try {
                const response = await fetch(
                    "http://localhost:7000/api/auth/reset-password",
                    {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            email:
                                contactMethod === "email" ? email : undefined,
                            phone:
                                contactMethod === "phone" ? phone : undefined,
                            otp: currentOtp,
                            newPassword,
                        }),
                    },
                );

                const data = await response.json();
                if (!response.ok) {
                    alert(data.message || "Reset failed");
                    return;
                }

                const step3 = document.getElementById("step3");
                const step4 = document.getElementById("step4");
                if (step3 && step4) {
                    step3.classList.remove("active");
                    step4.classList.add("active");
                    setTimeout(
                        () => (window.location.href = "/auth/customer-login"),
                        2000,
                    );
                }
            } catch (err) {
                console.error(err);
                alert("Error resetting password");
            }
        });
    }

    // Back buttons
    document.getElementById("back-to-step1")?.addEventListener("click", (e) => {
        e.preventDefault();
        document.getElementById("step2")?.classList.remove("active");
        document.getElementById("step1")?.classList.add("active");
    });

    document.getElementById("back-to-step2")?.addEventListener("click", (e) => {
        e.preventDefault();
        document.getElementById("step3")?.classList.remove("active");
        document.getElementById("step2")?.classList.add("active");
    });

    // OTP Input Navigation
    document.querySelectorAll(".otp-input").forEach((input) => {
        input.addEventListener("input", function (e) {
            const val = (e.target as HTMLInputElement).value;
            if (val.length === 1) {
                const next = input.nextElementSibling;
                if (next) (next as HTMLElement).focus();
            }
        });
    });
</script>
