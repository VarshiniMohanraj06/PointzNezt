---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="PointzNest - Customer Login">
    <header>
        <div class="container header-content">
            <div class="logo">
                <i class="fas fa-star"></i>
                <span>PointzNest</span>
            </div>
            <nav>
                <ul>
                    <li>
                        <a href="/auth/customer-login"
                            ><i class="fas fa-sign-in-alt"></i> Login</a
                        >
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <section class="login-section">
        <div class="container">
            <div class="login-container">
                <h2>Customer Login</h2>
                <form id="login-form">
                    <div class="form-group">
                        <label for="email">Email</label>
                        <!-- Changed type to email and id to email to match backend auth -->
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder="Enter your email"
                        />
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            placeholder="Enter your password"
                        />
                    </div>

                    <div
                        id="error-message"
                        style="color: red; text-align: center; margin-bottom: 1rem;"
                    >
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </button>
                    </div>

                    <div class="forgot-password">
                        <a href="/auth/customer-forgot-password"
                            >Forgot Password?</a
                        >
                    </div>

                    <div class="registration-link">
                        Don't have an account? <a href="/auth/customer-register"
                            >Register here</a
                        >
                    </div>
                </form>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* Scoped Styles */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }
    header {
        background-color: var(--primary);
        color: white;
        padding: 1rem 0;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .logo {
        font-size: 1.8rem;
        font-weight: bold;
        display: flex;
        align-items: center;
    }
    .logo i {
        margin-right: 10px;
        color: var(--secondary);
        animation: sparkle 2s infinite;
    }
    @keyframes sparkle {
        0% {
            text-shadow: 0 0 5px rgba(230, 126, 34, 0.5);
            transform: scale(1);
        }
        50% {
            text-shadow:
                0 0 20px rgba(230, 126, 34, 0.9),
                0 0 30px rgba(255, 255, 255, 0.8);
            transform: scale(1.1);
        }
        100% {
            text-shadow: 0 0 5px rgba(230, 126, 34, 0.5);
            transform: scale(1);
        }
    }
    nav ul {
        display: flex;
        list-style: none;
    }
    nav ul li {
        margin-left: 1.5rem;
        display: flex;
        align-items: center;
    }
    nav ul li a {
        color: white;
        text-decoration: none;
        transition: color 0.3s;
        display: flex;
        align-items: center;
        font-weight: 500;
        font-size: 1.1rem;
    }
    nav ul li a:hover {
        color: var(--secondary);
    }

    .btn {
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }
    .btn-primary {
        background-color: var(--secondary);
        color: white;
    }
    .btn-primary:hover {
        background-color: #d35400;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .login-section {
        background:
            linear-gradient(rgba(44, 62, 80, 0.85), rgba(44, 62, 80, 0.85)),
            url("https://images.unsplash.com/photo-1504754524776-8f4f37790ca0?auto=format&fit=crop&w=1400&q=80");
        background-size: cover;
        background-position: center;
        color: white;
        padding: 4rem 0;
        text-align: center;
        flex-grow: 1;
        display: flex;
        align-items: center;
        min-height: 80vh;
    }
    .login-container {
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 10px;
        padding: 2.5rem;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
    .login-container h2 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: white;
    }
    .form-group {
        margin-bottom: 1.5rem;
        text-align: left;
    }
    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }
    .form-group input {
        width: 100%;
        padding: 0.8rem 1rem;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        background: rgba(255, 255, 255, 0.9);
        color: #333;
    }
    .form-footer {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .form-footer .btn {
        width: 100%;
        padding: 1rem;
        font-size: 1.1rem;
    }
    .registration-link {
        margin-top: 1.5rem;
        color: #ddd;
        font-size: 1.1rem;
    }
    .registration-link a {
        color: var(--secondary);
        text-decoration: none;
        font-weight: 500;
    }
    .forgot-password {
        margin-top: 0.5rem;
        text-align: right;
    }
    .forgot-password a {
        color: #ddd;
        text-decoration: none;
        font-size: 0.9rem;
    }
</style>

<script>
    const loginForm = document.getElementById("login-form");
    const errorDisplay = document.getElementById("error-message");

    if (loginForm) {
        loginForm.addEventListener("submit", async function (e) {
            e.preventDefault();

            const email = (document.getElementById("email") as HTMLInputElement)
                .value;
            const password = (
                document.getElementById("password") as HTMLInputElement
            ).value;

            if (!email || !password) {
                if (errorDisplay)
                    errorDisplay.textContent = "Please fill in all fields";
                return;
            }

            try {
                // Using existing API endpoint structure
                // Adjust port if necessary or assume proxy
                // Development: http://localhost:3000/api/auth/login
                // Production/Relative: /api/auth/login

                const response = await fetch(
                    "http://localhost:7000/api/auth/login",
                    {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ email, password }),
                    },
                );

                const data = await response.json();

                if (response.ok) {
                    alert("Login successful! Redirecting...");
                    // Store token if returned (not implemented in backend yet, just basic auth)
                    // For now, redirect.
                    localStorage.setItem(
                        "customer",
                        JSON.stringify(data.customer),
                    );
                    window.location.href = "/customer/dashboard";
                } else {
                    if (errorDisplay)
                        errorDisplay.textContent =
                            data.message || "Login failed";
                }
            } catch (err) {
                console.error(err);
                if (errorDisplay)
                    errorDisplay.textContent =
                        "Server error. Please try again.";
            }
        });
    }
</script>
